generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN     // Volle Rechte, Benutzerverwaltung
  USER      // Standard-Bewohner
  GUEST     // Gast (eingeschraenkter Zugang)
  HAUSWART  // Hauswart-Funktionen (Ticketing, Reparaturen)
}

enum Side {
  NORD
  OST
}

enum TerminType {
  SITZUNG
  ESSEN
  SONSTIGE
}

enum AttendanceStatus {
  GOING
  NOT_GOING
}

enum Diet {
  FLEISCH
  VEGI
  VEGAN
}

enum NotificationKind {
  SAUNA
  TERMIN_NEW
  PUTZPLAN_MY_WG
  KAFFEE_CHANGED
  PINNWAND_NEW
  FLOHMI_NEW
  AUFGABE_NEW
  AUFGABE_STARTED
  BOOKING_COMMENT
  ACTIVITY_NEW
  ACTIVITY_COMMENT
}

model User {
  id          String    @id @default(cuid())
  name        String
  fullName    String?
  email       String    @unique
  password    String?
  roles       Role[]    @default([USER])
  setupToken  String?   @unique
  passwordSet Boolean   @default(false)
  avatar      String?
  birthday    DateTime?
  diet        Diet?
  allergies   String?
  notifyTermine         Boolean @default(true)
  notifyAufgaben        Boolean @default(true)
  notifyAufgabeStarted  Boolean @default(true)
  notifySauna           Boolean @default(true)
  notifyPutzplan        Boolean @default(true)
  notifyKaffee          Boolean @default(true)
  notifyPinnwand        Boolean @default(true)
  notifyFlohmi          Boolean @default(true)
  notifyBookingComment  Boolean @default(true)
  notifyActivity        Boolean @default(true)
  notifyActivityComment Boolean @default(true)
  hasKaffeeAbo          Boolean @default(false)
  favoriteAnimal        String?
  room        Room?     @relation(fields: [roomId], references: [id])
  roomId      String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  pinnwandNotes        PinnwandNote[]
  createdTermine       Termin[]              @relation("TerminCreator")
  createdTraktanden    Traktandum[]          @relation("TraktandumCreator")
  terminComments       TerminComment[]       @relation("TerminCommentAuthor")
  attendances          Attendance[]
  mealSignups          MealSignup[]
  createdAufgaben      Aufgabe[]             @relation("AufgabeCreator")
  activeAufgabenWorker AufgabeActiveWorker[]
  createdBookings      Booking[]             @relation("BookingCreator")
  bookingComments      BookingComment[]
  hausbuchArticlesCreated HausbuchArticle[]  @relation("HausbuchCreatedBy")
  hausbuchArticlesUpdated HausbuchArticle[]  @relation("HausbuchUpdatedBy")
  createdFlohmi        FlohmiInserat[]       @relation("FlohmiCreator")
  takenFlohmi          FlohmiInserat[]       @relation("FlohmiTaker")
  flohmiComments       FlohmiComment[]
  notifications        Notification[]
  pushSubscriptions    PushSubscription[]
  createdActivities    Activity[]            @relation("ActivityCreator")
  activityParticipations ActivityParticipant[]
  activityComments     ActivityComment[]

  @@map("users")
}

model PinnwandNote {
  id        String   @id @default(cuid())
  text      String
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  authorId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([createdAt])
  @@map("pinnwand_notes")
}

model Termin {
  id                String           @id @default(cuid())
  title             String
  // date = Start-Datum mit Uhrzeit, als UTC gespeichert
  date              DateTime
  location          String           @default("")
  type              TerminType
  organizer         String?
  withDinner        Boolean          @default(false)
  dinnerTime        String?
  // Fuer Sitzung+Essen: optional separater Ort / Organisator / Menu
  dinnerLocation    String?
  dinnerOrganizer   String?
  dinnerMenu        String?
  withAttendance    Boolean          @default(false)
  sitzungsleitung   String           @default("")
  protokollfuehrung String           @default("")
  createdBy         User             @relation("TerminCreator", fields: [createdById], references: [id])
  createdById       String
  traktanden        Traktandum[]
  attendances       Attendance[]
  mealSignups       MealSignup[]
  comments          TerminComment[]
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  @@index([date])
  @@map("termine")
}

model TerminComment {
  id        String   @id @default(cuid())
  termin    Termin   @relation(fields: [terminId], references: [id], onDelete: Cascade)
  terminId  String
  author    User     @relation("TerminCommentAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  authorId  String
  text      String
  createdAt DateTime @default(now())

  @@index([terminId])
  @@map("termin_comments")
}

model Traktandum {
  id          String   @id @default(cuid())
  termin      Termin   @relation(fields: [terminId], references: [id], onDelete: Cascade)
  terminId    String
  title       String
  notes       String   @default("")
  order       Int      @default(0)
  createdBy   User     @relation("TraktandumCreator", fields: [createdById], references: [id])
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([terminId])
  @@map("traktanden")
}

model Attendance {
  id        String           @id @default(cuid())
  termin    Termin           @relation(fields: [terminId], references: [id], onDelete: Cascade)
  terminId  String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  status    AttendanceStatus
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@unique([terminId, userId])
  @@map("attendances")
}

model MealSignup {
  id         String            @id @default(cuid())
  termin     Termin            @relation(fields: [terminId], references: [id], onDelete: Cascade)
  terminId   String
  user       User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     String
  // Ob der User selbst kommt (false = nur Gaeste oder explizite Absage)
  goingSelf  Boolean           @default(true)
  diet       Diet
  allergies  String            @default("")
  guests     MealSignupGuest[]
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  @@unique([terminId, userId])
  @@map("meal_signups")
}

model MealSignupGuest {
  id           String     @id @default(cuid())
  mealSignup   MealSignup @relation(fields: [mealSignupId], references: [id], onDelete: Cascade)
  mealSignupId String
  diet         Diet
  allergies    String     @default("")
  createdAt    DateTime   @default(now())

  @@index([mealSignupId])
  @@map("meal_signup_guests")
}

model Aufgabe {
  id            String                @id @default(cuid())
  title         String
  description   String                @default("")
  location      String                @default("")
  done          Boolean               @default(false)
  completedAt   DateTime?
  // Optionaler Pin auf der Satellit-Karte
  pinLat        Float?
  pinLng        Float?
  // assignee wird aktuell als freier Name-String gepflegt
  assignee      String?
  createdBy     User                  @relation("AufgabeCreator", fields: [createdById], references: [id])
  createdById   String
  activeWorkers AufgabeActiveWorker[]
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt

  @@index([done, createdAt])
  @@map("aufgaben")
}

model AufgabeActiveWorker {
  id        String   @id @default(cuid())
  aufgabe   Aufgabe  @relation(fields: [aufgabeId], references: [id], onDelete: Cascade)
  aufgabeId String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  startedAt DateTime @default(now())

  @@unique([aufgabeId, userId])
  @@map("aufgabe_active_workers")
}

model Booking {
  id          String           @id @default(cuid())
  guest       String
  // Start- und End-Datum der Buchung (inklusive)
  fromDate    DateTime
  toDate      DateTime
  createdBy   User             @relation("BookingCreator", fields: [createdById], references: [id])
  createdById String
  comments    BookingComment[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([fromDate])
  @@map("bookings")
}

model BookingComment {
  id        String   @id @default(cuid())
  booking   Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  bookingId String
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  authorId  String
  text      String
  createdAt DateTime @default(now())

  @@index([bookingId])
  @@map("booking_comments")
}

model FlohmiInserat {
  id          String           @id @default(cuid())
  title       String
  description String           @default("")
  // Erstes Bild (Backwards-Compat / Thumbnail)
  image       String?
  images      FlohmiImage[]
  createdBy   User             @relation("FlohmiCreator", fields: [createdById], references: [id])
  createdById String
  takenBy     User?            @relation("FlohmiTaker", fields: [takenById], references: [id])
  takenById   String?
  takenAt     DateTime?
  comments    FlohmiComment[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([createdAt])
  @@index([takenAt])
  @@map("flohmi_inserate")
}

model FlohmiImage {
  id        String        @id @default(cuid())
  inserat   FlohmiInserat @relation(fields: [inseratId], references: [id], onDelete: Cascade)
  inseratId String
  // Base64 Data-URL
  data      String
  order     Int           @default(0)
  createdAt DateTime      @default(now())

  @@index([inseratId])
  @@map("flohmi_images")
}

model FlohmiComment {
  id        String        @id @default(cuid())
  inserat   FlohmiInserat @relation(fields: [inseratId], references: [id], onDelete: Cascade)
  inseratId String
  author    User          @relation(fields: [authorId], references: [id], onDelete: Cascade)
  authorId  String
  text      String
  createdAt DateTime      @default(now())

  @@index([inseratId])
  @@map("flohmi_comments")
}

model Notification {
  id        String           @id @default(cuid())
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  kind      NotificationKind
  title     String
  body      String?
  link      String?
  read      Boolean          @default(false)
  createdAt DateTime         @default(now())

  @@index([userId, createdAt])
  @@index([userId, read])
  @@map("notifications")
}

model PushSubscription {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("push_subscriptions")
}

model Activity {
  id           String                @id @default(cuid())
  title        String
  description  String                @default("")
  location     String                @default("")
  // Start-Zeitpunkt der Aktivitaet
  startAt      DateTime
  createdBy    User                  @relation("ActivityCreator", fields: [createdById], references: [id])
  createdById  String
  participants ActivityParticipant[]
  comments     ActivityComment[]
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt

  @@index([startAt])
  @@map("activities")
}

model ActivityParticipant {
  id         String   @id @default(cuid())
  activity   Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  activityId String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     String
  // true = kommt, false = abgesagt
  going      Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([activityId, userId])
  @@map("activity_participants")
}

model ActivityComment {
  id         String   @id @default(cuid())
  activity   Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  activityId String
  author     User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  authorId   String
  text       String
  createdAt  DateTime @default(now())

  @@index([activityId])
  @@map("activity_comments")
}

model HausbuchArticle {
  id          String   @id @default(cuid())
  title       String
  content     String
  category    String
  // Owner als freier Name-String (analog zum UI-Eingabefeld)
  owner       String
  createdBy   User?    @relation("HausbuchCreatedBy", fields: [createdById], references: [id])
  createdById String?
  updatedBy   User     @relation("HausbuchUpdatedBy", fields: [updatedById], references: [id])
  updatedById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([category])
  @@map("hausbuch_articles")
}

model Wg {
  id        String   @id @default(cuid())
  name      String   @unique
  floor     Int      // 0=EG, 1=1.OG, 2=2.OG
  side      Side
  rooms     Room[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Room {
  id        String   @id @default(cuid())
  keyNumber String   @unique // z.B. "N01", "O24"
  number    Int      // Zimmernummer innerhalb der WG (1-5)
  wg        Wg       @relation(fields: [wgId], references: [id])
  wgId      String
  users     User[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
