generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN     // Volle Rechte, Benutzerverwaltung
  USER      // Standard-Bewohner
  GUEST     // Gast (eingeschraenkter Zugang)
  HAUSWART  // Hauswart-Funktionen (Ticketing, Reparaturen)
}

model User {
  id          String   @id @default(cuid())
  name        String
  email       String   @unique
  password    String?
  roles       Role[]   @default([USER])
  setupToken  String?  @unique
  passwordSet Boolean  @default(false)
  avatar      String?
  wgId        String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("users")
}
