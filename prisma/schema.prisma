generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN     // Volle Rechte, Benutzerverwaltung
  USER      // Standard-Bewohner
  GUEST     // Gast (eingeschraenkter Zugang)
  HAUSWART  // Hauswart-Funktionen (Ticketing, Reparaturen)
}

enum Side {
  NORD
  OST
}

enum TerminType {
  SITZUNG
  ESSEN
  SONSTIGE
}

enum AttendanceStatus {
  GOING
  NOT_GOING
}

enum Diet {
  FLEISCH
  VEGI
  VEGAN
}

enum NotificationKind {
  SAUNA
  TERMIN_NEW
  PUTZPLAN_MY_WG
  KAFFEE_CHANGED
  PINNWAND_NEW
  FLOHMI_NEW
  AUFGABE_NEW
  AUFGABE_STARTED
  BOOKING_COMMENT
  ACTIVITY_NEW
  ACTIVITY_COMMENT
  FLOHMI_TAKEN
  PINNWAND_COMMENT
  SHOPPING_COMMENT
  FEEDBACK_COMMENT
  FEEDBACK_RESOLVED
  LAUNDRY_DONE
}

model User {
  id          String    @id @default(cuid())
  name        String
  fullName    String?
  email       String    @unique
  password    String?
  roles       Role[]    @default([USER])
  setupToken  String?   @unique
  passwordSet Boolean   @default(false)
  avatar      String?
  birthday    DateTime?
  diet        Diet?
  allergies   String?
  notifyTermine         Boolean @default(true)
  notifyAufgaben        Boolean @default(true)
  notifyAufgabeStarted  Boolean @default(true)
  notifySauna           Boolean @default(true)
  notifyPutzplan        Boolean @default(true)
  notifyKaffee          Boolean @default(true)
  notifyPinnwand        Boolean @default(true)
  notifyFlohmi          Boolean @default(true)
  notifyBookingComment  Boolean @default(true)
  notifyActivity        Boolean @default(true)
  notifyActivityComment Boolean @default(true)
  notifyMyPostsComment  Boolean @default(true)
  notifyLaundry         Boolean @default(true)
  hasKaffeeAbo          Boolean @default(false)
  favoriteAnimal        String?
  gameHighScore         Int     @default(0)
  room        Room?     @relation(fields: [roomId], references: [id])
  roomId      String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  pinnwandNotes        PinnwandNote[]
  createdTermine       Termin[]              @relation("TerminCreator")
  createdTraktanden    Traktandum[]          @relation("TraktandumCreator")
  terminComments       TerminComment[]       @relation("TerminCommentAuthor")
  attendances          Attendance[]
  mealSignups          MealSignup[]
  createdAufgaben      Aufgabe[]             @relation("AufgabeCreator")
  activeAufgabenWorker AufgabeActiveWorker[]
  createdBookings      Booking[]             @relation("BookingCreator")
  bookingComments      BookingComment[]
  hausbuchArticlesCreated HausbuchArticle[]  @relation("HausbuchCreatedBy")
  hausbuchArticlesUpdated HausbuchArticle[]  @relation("HausbuchUpdatedBy")
  createdFlohmi        FlohmiInserat[]       @relation("FlohmiCreator")
  takenFlohmi          FlohmiInserat[]       @relation("FlohmiTaker")
  flohmiComments       FlohmiComment[]
  notifications        Notification[]
  pushSubscriptions    PushSubscription[]
  createdActivities    Activity[]            @relation("ActivityCreator")
  activityParticipations ActivityParticipant[]
  activityComments     ActivityComment[]
  reportedDamages      RoomDamage[]          @relation("DamageReporter")
  damageFeedbacks      RoomDamageFeedback[]  @relation("DamageFeedbackAuthor")
  createdSublets       Sublet[]              @relation("SubletCreator")
  pinnwandComments     PinnwandComment[]     @relation("PinnwandCommentAuthor")
  createdShopping      ShoppingItem[]        @relation("ShoppingCreator")
  completedShopping    ShoppingItem[]        @relation("ShoppingCompleter")
  shoppingComments     ShoppingItemComment[] @relation("ShoppingCommentAuthor")
  gameScores           GameScore[]
  laundryTimers        LaundryTimer[]        @relation("LaundryTimerStarter")
  laundryTimerWatches  LaundryTimerWatch[]

  @@map("users")
}

model GameScore {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  score     Int
  game      String   @default("tetris")
  createdAt DateTime @default(now())

  @@index([score(sort: Desc)])
  @@index([userId])
  @@index([game, score(sort: Desc)])
  @@map("game_scores")
}

model PinnwandNote {
  id        String   @id @default(cuid())
  text      String
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  authorId  String
  comments  PinnwandComment[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([createdAt])
  @@map("pinnwand_notes")
}

model PinnwandComment {
  id        String       @id @default(cuid())
  note      PinnwandNote @relation(fields: [noteId], references: [id], onDelete: Cascade)
  noteId    String
  author    User         @relation("PinnwandCommentAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  authorId  String
  text      String
  createdAt DateTime     @default(now())

  @@index([noteId])
  @@map("pinnwand_comments")
}

model Termin {
  id                String           @id @default(cuid())
  title             String
  // date = Start-Datum mit Uhrzeit, als UTC gespeichert
  date              DateTime
  location          String           @default("")
  type              TerminType
  organizer         String?
  withDinner        Boolean          @default(false)
  dinnerTime        String?
  // Fuer Sitzung+Essen: optional separater Ort / Organisator / Menu
  dinnerLocation    String?
  dinnerOrganizer   String?
  dinnerMenu        String?
  withAttendance    Boolean          @default(false)
  sitzungsleitung   String           @default("")
  protokollfuehrung String           @default("")
  createdBy         User             @relation("TerminCreator", fields: [createdById], references: [id])
  createdById       String
  traktanden        Traktandum[]
  attendances       Attendance[]
  mealSignups       MealSignup[]
  comments          TerminComment[]
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  @@index([date])
  @@map("termine")
}

model TerminComment {
  id        String   @id @default(cuid())
  termin    Termin   @relation(fields: [terminId], references: [id], onDelete: Cascade)
  terminId  String
  author    User     @relation("TerminCommentAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  authorId  String
  text      String
  createdAt DateTime @default(now())

  @@index([terminId])
  @@map("termin_comments")
}

model Traktandum {
  id          String   @id @default(cuid())
  termin      Termin   @relation(fields: [terminId], references: [id], onDelete: Cascade)
  terminId    String
  title       String
  notes       String   @default("")
  order       Int      @default(0)
  createdBy   User     @relation("TraktandumCreator", fields: [createdById], references: [id])
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([terminId])
  @@map("traktanden")
}

model Attendance {
  id        String           @id @default(cuid())
  termin    Termin           @relation(fields: [terminId], references: [id], onDelete: Cascade)
  terminId  String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  status    AttendanceStatus
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@unique([terminId, userId])
  @@map("attendances")
}

model MealSignup {
  id         String            @id @default(cuid())
  termin     Termin            @relation(fields: [terminId], references: [id], onDelete: Cascade)
  terminId   String
  user       User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     String
  // Ob der User selbst kommt (false = nur Gaeste oder explizite Absage)
  goingSelf  Boolean           @default(true)
  diet       Diet
  allergies  String            @default("")
  guests     MealSignupGuest[]
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  @@unique([terminId, userId])
  @@map("meal_signups")
}

model MealSignupGuest {
  id           String     @id @default(cuid())
  mealSignup   MealSignup @relation(fields: [mealSignupId], references: [id], onDelete: Cascade)
  mealSignupId String
  name         String     @default("")
  diet         Diet
  allergies    String     @default("")
  createdAt    DateTime   @default(now())

  @@index([mealSignupId])
  @@map("meal_signup_guests")
}

model Aufgabe {
  id            String                @id @default(cuid())
  title         String
  description   String                @default("")
  location      String                @default("")
  done          Boolean               @default(false)
  completedAt   DateTime?
  // Optionaler Pin auf der Satellit-Karte
  pinLat        Float?
  pinLng        Float?
  // assignee wird aktuell als freier Name-String gepflegt
  assignee      String?
  createdBy     User                  @relation("AufgabeCreator", fields: [createdById], references: [id])
  createdById   String
  activeWorkers AufgabeActiveWorker[]
  subTodos      AufgabeSubTodo[]
  images        AufgabeImage[]
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt

  @@index([done, createdAt])
  @@map("aufgaben")
}

model AufgabeSubTodo {
  id        String   @id @default(cuid())
  aufgabe   Aufgabe  @relation(fields: [aufgabeId], references: [id], onDelete: Cascade)
  aufgabeId String
  title     String
  done      Boolean  @default(false)
  position  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([aufgabeId, position])
  @@map("aufgabe_sub_todos")
}

model AufgabeImage {
  id        String   @id @default(cuid())
  aufgabe   Aufgabe  @relation(fields: [aufgabeId], references: [id], onDelete: Cascade)
  aufgabeId String
  // Base64 Data-URL (JPEG, max 1400px, ~0.78 quality)
  data      String
  position  Int      @default(0)
  createdAt DateTime @default(now())

  @@index([aufgabeId, position])
  @@map("aufgabe_images")
}

model AufgabeActiveWorker {
  id        String   @id @default(cuid())
  aufgabe   Aufgabe  @relation(fields: [aufgabeId], references: [id], onDelete: Cascade)
  aufgabeId String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  startedAt DateTime @default(now())

  @@unique([aufgabeId, userId])
  @@map("aufgabe_active_workers")
}

model Booking {
  id          String           @id @default(cuid())
  guest       String
  // Start- und End-Datum der Buchung (inklusive)
  fromDate    DateTime
  toDate      DateTime
  createdBy   User             @relation("BookingCreator", fields: [createdById], references: [id])
  createdById String
  comments    BookingComment[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([fromDate])
  @@map("bookings")
}

model BookingComment {
  id        String   @id @default(cuid())
  booking   Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  bookingId String
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  authorId  String
  text      String
  createdAt DateTime @default(now())

  @@index([bookingId])
  @@map("booking_comments")
}

model FlohmiInserat {
  id          String           @id @default(cuid())
  title       String
  description String           @default("")
  price       String?
  // Erstes Bild (Backwards-Compat / Thumbnail)
  image       String?
  images      FlohmiImage[]
  createdBy   User             @relation("FlohmiCreator", fields: [createdById], references: [id])
  createdById String
  takenBy     User?            @relation("FlohmiTaker", fields: [takenById], references: [id])
  takenById   String?
  takenAt     DateTime?
  comments    FlohmiComment[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([createdAt])
  @@index([takenAt])
  @@map("flohmi_inserate")
}

model FlohmiImage {
  id        String        @id @default(cuid())
  inserat   FlohmiInserat @relation(fields: [inseratId], references: [id], onDelete: Cascade)
  inseratId String
  // Base64 Data-URL
  data      String
  order     Int           @default(0)
  createdAt DateTime      @default(now())

  @@index([inseratId])
  @@map("flohmi_images")
}

model FlohmiComment {
  id        String        @id @default(cuid())
  inserat   FlohmiInserat @relation(fields: [inseratId], references: [id], onDelete: Cascade)
  inseratId String
  author    User          @relation(fields: [authorId], references: [id], onDelete: Cascade)
  authorId  String
  text      String
  createdAt DateTime      @default(now())

  @@index([inseratId])
  @@map("flohmi_comments")
}

model Notification {
  id        String           @id @default(cuid())
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  kind      NotificationKind
  title     String
  body      String?
  link      String?
  read      Boolean          @default(false)
  createdAt DateTime         @default(now())

  @@index([userId, createdAt])
  @@index([userId, read])
  @@map("notifications")
}

model PushSubscription {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("push_subscriptions")
}

model LaundryTimer {
  id                 String    @id @default(cuid())
  machineKey         String
  machineName        String
  programName        String
  durationMinutes    Int
  startedAt          DateTime  @default(now())
  endsAt             DateTime
  stoppedAt          DateTime?
  notificationSentAt DateTime?
  starter            User      @relation("LaundryTimerStarter", fields: [starterId], references: [id], onDelete: Cascade)
  starterId          String
  watches            LaundryTimerWatch[]
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([machineKey, endsAt])
  @@index([starterId])
  @@map("laundry_timers")
}

model LaundryTimerWatch {
  id        String       @id @default(cuid())
  timer     LaundryTimer @relation(fields: [timerId], references: [id], onDelete: Cascade)
  timerId   String
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  createdAt DateTime     @default(now())

  @@unique([timerId, userId])
  @@index([userId])
  @@map("laundry_timer_watches")
}

model Activity {
  id           String                @id @default(cuid())
  title        String
  description  String                @default("")
  location     String                @default("")
  // Start-Zeitpunkt der Aktivitaet
  startAt      DateTime
  // Serien-ID fuer wiederkehrende Aktivitaeten (null = einmalig)
  recurrenceGroupId String?
  createdBy    User                  @relation("ActivityCreator", fields: [createdById], references: [id])
  createdById  String
  participants ActivityParticipant[]
  comments     ActivityComment[]
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt

  @@index([startAt])
  @@index([recurrenceGroupId])
  @@map("activities")
}

model ActivityParticipant {
  id         String   @id @default(cuid())
  activity   Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  activityId String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     String
  // true = kommt, false = abgesagt
  going      Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([activityId, userId])
  @@map("activity_participants")
}

model ActivityComment {
  id         String   @id @default(cuid())
  activity   Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  activityId String
  author     User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  authorId   String
  text       String
  createdAt  DateTime @default(now())

  @@index([activityId])
  @@map("activity_comments")
}

model HausbuchArticle {
  id          String   @id @default(cuid())
  title       String
  summary     String?
  content     String
  structured  Json?
  type        String   @default("INFO")
  category    String
  section     String?
  tags        String[] @default([])
  pinned      Boolean  @default(false)
  status      String   @default("PUBLISHED")
  // Owner als freier Name-String (analog zum UI-Eingabefeld)
  owner       String
  createdBy   User?    @relation("HausbuchCreatedBy", fields: [createdById], references: [id])
  createdById String?
  updatedBy   User     @relation("HausbuchUpdatedBy", fields: [updatedById], references: [id])
  updatedById String
  images      HausbuchImage[]
  linksFrom   HausbuchArticleLink[] @relation("HausbuchLinksFrom")
  linksTo     HausbuchArticleLink[] @relation("HausbuchLinksTo")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([type])
  @@index([category])
  @@index([section])
  @@map("hausbuch_articles")
}

model HausbuchImage {
  id        String          @id @default(cuid())
  article   HausbuchArticle @relation(fields: [articleId], references: [id], onDelete: Cascade)
  articleId String
  // Base64 Data-URL, analog zu Flohmi-Bildern
  data      String
  caption   String?
  stepId    String?
  order     Int             @default(0)
  createdAt DateTime        @default(now())

  @@index([articleId])
  @@map("hausbuch_images")
}

model HausbuchArticleLink {
  id        String          @id @default(cuid())
  from      HausbuchArticle @relation("HausbuchLinksFrom", fields: [fromId], references: [id], onDelete: Cascade)
  fromId    String
  to        HausbuchArticle @relation("HausbuchLinksTo", fields: [toId], references: [id], onDelete: Cascade)
  toId      String
  label     String?
  createdAt DateTime        @default(now())

  @@unique([fromId, toId])
  @@index([toId])
  @@map("hausbuch_article_links")
}

model Wg {
  id        String   @id @default(cuid())
  name      String   @unique
  floor     Int      // 0=EG, 1=1.OG, 2=2.OG
  side      Side
  rooms     Room[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Room {
  id        String   @id @default(cuid())
  keyNumber String   @unique // z.B. "N01", "O24"
  number    Int      // Zimmernummer innerhalb der WG (1-5)
  wg        Wg       @relation(fields: [wgId], references: [id])
  wgId      String
  users     User[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Schaeden an einem Raum (Zimmer oder Gemeinschaftsraum)
// roomKey speichert die keyNumber (z.B. "N01", "N0-BAD") — Raeume aus
// bewohnende-data.ts sind derzeit teilweise noch Mock, daher loose
// verknuepft ueber einen String statt FK.
model RoomDamage {
  id            String    @id @default(cuid())
  title         String    @default("")
  roomKey       String    @default("")
  location      String    @default("")
  description   String
  category      String    @default("allgemein") // "allgemein" | "sanierung" | "wasser" | "elektro" | ...
  status        String    @default("gemeldet") // "gemeldet" | "in_bearbeitung" | "rueckmeldung" | "termin_gesetzt" | "erledigt"
  severity      String    @default("klein") // "klein" | "mittel" | "gross"
  pinLat        Float?
  pinLng        Float?
  imageData     String?
  invoiceData   String?
  invoiceName   String?
  costCents     Int?
  appointmentAt DateTime?
  reportedBy    User?     @relation("DamageReporter", fields: [reportedById], references: [id])
  reportedById  String?
  reportedAt    DateTime  @default(now())
  resolvedAt    DateTime?
  feedbacks     RoomDamageFeedback[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([category])
  @@index([status])
  @@index([roomKey])
  @@index([resolvedAt])
  @@map("room_damages")
}

model RoomDamageFeedback {
  id        String     @id @default(cuid())
  damage    RoomDamage @relation(fields: [damageId], references: [id], onDelete: Cascade)
  damageId  String
  author    User       @relation("DamageFeedbackAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  authorId  String
  text      String
  createdAt DateTime   @default(now())

  @@index([damageId])
  @@map("room_damage_feedbacks")
}

// Einkaufsliste fuer alles Moegliche (Anzuendwuerfel, Holzbriketts, Holz, …)
model ShoppingItem {
  id             String               @id @default(cuid())
  title          String
  notes          String               @default("")
  done           Boolean              @default(false)
  createdBy      User                 @relation("ShoppingCreator", fields: [createdById], references: [id])
  createdById    String
  completedBy    User?                @relation("ShoppingCompleter", fields: [completedById], references: [id])
  completedById  String?
  completedAt    DateTime?
  comments       ShoppingItemComment[]
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  @@index([done, createdAt])
  @@map("shopping_items")
}

model ShoppingItemComment {
  id        String       @id @default(cuid())
  item      ShoppingItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  itemId    String
  author    User         @relation("ShoppingCommentAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  authorId  String
  text      String
  createdAt DateTime     @default(now())

  @@index([itemId])
  @@map("shopping_item_comments")
}

// Untermiete fuer ein Zimmer
model Sublet {
  id               String   @id @default(cuid())
  roomKey          String
  subtenantName    String   // Anzeigename der Untermieter:in
  subtenantFullName String  @default("")
  subtenantPhone   String   @default("")
  subtenantEmail   String   @default("")
  fromDate         DateTime
  toDate           DateTime
  notes            String   @default("")
  createdBy        User     @relation("SubletCreator", fields: [createdById], references: [id])
  createdById      String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([roomKey])
  @@index([fromDate])
  @@map("sublets")
}

model PutzplanEntry {
  id          String   @id @default(cuid())
  wg          String
  order       Int
  completedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([wg])
  @@index([order])
  @@map("putzplan_entries")
}

model KaffeeCurrent {
  id          String   @id @default("singleton")
  name        String
  herkunft    String   @default("")
  duftnotizen String   @default("")
  fairtrade   Boolean  @default(false)
  changedBy   String   @default("")
  changedAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("kaffee_current")
}

model Feedback {
  id          String            @id @default(cuid())
  type        String
  title       String
  description String            @default("")
  authorName  String
  authorEmail String
  githubIssue Int?
  status      String            @default("offen")
  comments    FeedbackComment[]
  createdAt   DateTime          @default(now())

  @@index([createdAt])
  @@map("feedbacks")
}

model FeedbackComment {
  id         String   @id @default(cuid())
  feedback   Feedback @relation(fields: [feedbackId], references: [id], onDelete: Cascade)
  feedbackId String
  authorName String
  text       String
  createdAt  DateTime @default(now())

  @@index([feedbackId])
  @@map("feedback_comments")
}

model SaunaReading {
  id          Int      @id @default(autoincrement())
  tempTopC    Decimal  @db.Decimal(5, 2)
  tempBottomC Decimal? @db.Decimal(5, 2)
  rssi        Int?
  recordedAt  DateTime @default(now())

  @@index([recordedAt])
  @@map("sauna_readings")
}
