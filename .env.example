# Database
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db:5432/via1

# NextAuth
NEXTAUTH_SECRET=your-secret-here
NEXTAUTH_URL=https://app.felsenau.org

# GitHub (for creating issues from app feedback)
GITHUB_TOKEN=ghp_your_personal_access_token

# Postgres (used by docker-compose for the db service)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=YOUR_PASSWORD
POSTGRES_DB=via1

# Web Push Notifications — VAPID-Keys erzeugen mit:
#   npx web-push generate-vapid-keys
# Wenn nicht gesetzt, wird die Push-Funktion deaktiviert (In-App-Notifs
# bleiben aber aktiv).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@via1.ch

# Anthropic Claude API — wird fuer Kaffee-Etikette-Scan (Vision) genutzt.
# Key holen: https://console.anthropic.com/settings/keys
# Wenn nicht gesetzt, meldet der Scan "manuell erfassen".
ANTHROPIC_API_KEY=
